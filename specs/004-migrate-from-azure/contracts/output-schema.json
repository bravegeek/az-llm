{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://az-llm.example.com/schemas/ai-foundry-hubless-output-v2.json",
  "title": "Azure AI Foundry Hub-less Deployment Outputs",
  "description": "Output schema for Azure AI Foundry hub-less infrastructure deployment results (compatible with .env format). Includes 3 standard models (Bicep-deployed) + 2 serverless models (manual deployment placeholders).",
  "type": "object",
  "required": [
    "aiServicesResourceId",
    "projectResourceId",
    "aiServicesEndpoint",
    "gpt4Deployment",
    "gpt4oMiniDeployment",
    "gpt4oDeployment"
  ],
  "properties": {
    "aiServicesResourceId": {
      "type": "string",
      "description": "Azure Resource Manager ID of the AI Foundry AIServices account",
      "pattern": "^/subscriptions/[0-9a-f-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.CognitiveServices/accounts/[^/]+$",
      "examples": [
        "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/rg-ai-foundry/providers/Microsoft.CognitiveServices/accounts/ai-foundry-prod"
      ]
    },
    "projectResourceId": {
      "type": "string",
      "description": "Azure Resource Manager ID of the AI Foundry Project",
      "pattern": "^/subscriptions/[0-9a-f-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.CognitiveServices/accounts/[^/]+/projects/[^/]+$",
      "examples": [
        "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/rg-ai-foundry/providers/Microsoft.CognitiveServices/accounts/ai-foundry-prod/projects/foundry-project"
      ]
    },
    "aiServicesEndpoint": {
      "type": "string",
      "description": "AI Services endpoint URL (OpenAI-compatible)",
      "format": "uri",
      "pattern": "^https://[a-z0-9-]+\\.(openai|cognitiveservices)\\.azure\\.com/?$",
      "examples": [
        "https://ai-prod.openai.azure.com/"
      ]
    },
    "gpt4Deployment": {
      "$ref": "#/definitions/standardModelDeployment",
      "description": "GPT-4 deployment details (Bicep-deployed)"
    },
    "gpt4oMiniDeployment": {
      "$ref": "#/definitions/standardModelDeployment",
      "description": "GPT-4o-mini deployment details (Bicep-deployed)"
    },
    "gpt4oDeployment": {
      "$ref": "#/definitions/standardModelDeployment",
      "description": "GPT-4o deployment details (Bicep-deployed)"
    },
    "fluxDeployment": {
      "$ref": "#/definitions/serverlessModelDeployment",
      "description": "FLUX-1.1-pro deployment details (manual deployment placeholder)"
    },
    "deepseekDeployment": {
      "$ref": "#/definitions/serverlessModelDeployment",
      "description": "DeepSeek-V3.1 deployment details (manual deployment placeholder)"
    }
  },
  "definitions": {
    "standardModelDeployment": {
      "type": "object",
      "description": "Standard OpenAI model deployment (deployed via Bicep with TPM allocation)",
      "required": ["deploymentName", "model", "version", "capacity", "endpoint"],
      "properties": {
        "deploymentName": {
          "type": "string",
          "description": "Deployment name in Azure",
          "examples": ["gpt-4-deployment", "gpt-4o-mini-deployment"]
        },
        "model": {
          "type": "string",
          "description": "Model identifier",
          "enum": ["gpt-4", "gpt-4o-mini", "gpt-4o"],
          "examples": ["gpt-4", "gpt-4o-mini", "gpt-4o"]
        },
        "version": {
          "type": "string",
          "description": "Model version",
          "examples": ["1106-preview", "2025-04-14", "2024-08-06"]
        },
        "capacity": {
          "type": "integer",
          "description": "Allocated capacity in thousands of TPM",
          "minimum": 1,
          "maximum": 1000,
          "examples": [50, 100]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Model-specific endpoint URL",
          "pattern": "^https://[a-z0-9-]+\\.openai\\.azure\\.com/?$",
          "examples": ["https://ai-prod.openai.azure.com/"]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "deploymentName": "gpt-4-deployment",
          "model": "gpt-4",
          "version": "1106-preview",
          "capacity": 50,
          "endpoint": "https://ai-prod.openai.azure.com/"
        }
      ]
    },
    "serverlessModelDeployment": {
      "type": "object",
      "description": "Serverless model deployment (manual deployment via AI Foundry portal, no TPM)",
      "required": ["deploymentStatus"],
      "properties": {
        "deploymentStatus": {
          "type": "string",
          "enum": ["manual-required", "deployed"],
          "description": "Deployment status indicator",
          "default": "manual-required"
        },
        "model": {
          "type": "string",
          "description": "Model identifier (if deployed)",
          "enum": ["FLUX-1.1-pro", "DeepSeek-V3.1"],
          "examples": ["FLUX-1.1-pro", "DeepSeek-V3.1"]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Serverless API endpoint URL (if deployed)",
          "examples": ["https://FLUX-1-1-pro-abcde.eastus2.models.ai.azure.com/"]
        },
        "key": {
          "type": "string",
          "description": "API key for serverless endpoint (if deployed)",
          "x-sensitive": true
        },
        "deploymentInstructions": {
          "type": "string",
          "description": "Instructions for manual deployment",
          "examples": [
            "Navigate to https://ai.azure.com, select project, go to Model Catalog, search 'FLUX-1.1-pro', click 'Deploy' → Serverless API"
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "deploymentStatus": "manual-required",
          "model": "FLUX-1.1-pro",
          "deploymentInstructions": "Navigate to https://ai.azure.com, select project, go to Model Catalog, search 'FLUX-1.1-pro', click 'Deploy' → Serverless API"
        },
        {
          "deploymentStatus": "deployed",
          "model": "DeepSeek-V3.1",
          "endpoint": "https://DeepSeek-V3-1-abcde.eastus2.models.ai.azure.com/",
          "key": "********************************"
        }
      ]
    }
  },
  "examples": [
    {
      "aiServicesResourceId": "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/rg-ai-foundry/providers/Microsoft.CognitiveServices/accounts/ai-foundry-prod",
      "projectResourceId": "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/rg-ai-foundry/providers/Microsoft.CognitiveServices/accounts/ai-foundry-prod/projects/foundry-project",
      "aiServicesEndpoint": "https://ai-prod.openai.azure.com/",
      "gpt4Deployment": {
        "deploymentName": "gpt-4-deployment",
        "model": "gpt-4",
        "version": "1106-preview",
        "capacity": 50,
        "endpoint": "https://ai-prod.openai.azure.com/"
      },
      "gpt4oMiniDeployment": {
        "deploymentName": "gpt-4o-mini-deployment",
        "model": "gpt-4o-mini",
        "version": "2025-04-14",
        "capacity": 100,
        "endpoint": "https://ai-prod.openai.azure.com/"
      },
      "gpt4oDeployment": {
        "deploymentName": "gpt-4o-deployment",
        "model": "gpt-4o",
        "version": "2024-08-06",
        "capacity": 50,
        "endpoint": "https://ai-prod.openai.azure.com/"
      },
      "fluxDeployment": {
        "deploymentStatus": "manual-required",
        "model": "FLUX-1.1-pro",
        "deploymentInstructions": "Navigate to https://ai.azure.com, select project, go to Model Catalog, search 'FLUX-1.1-pro', click 'Deploy' → Serverless API"
      },
      "deepseekDeployment": {
        "deploymentStatus": "manual-required",
        "model": "DeepSeek-V3.1",
        "deploymentInstructions": "Navigate to https://ai.azure.com, select project, go to Model Catalog, search 'DeepSeek-V3.1', click 'Deploy' → Serverless API"
      }
    }
  ],
  "x-dotenv-format": {
    "description": "Output can be converted to .env format using scripts/outputs.sh",
    "example": "AI_SERVICES_ID=/subscriptions/.../accounts/ai-foundry-prod\nAI_SERVICES_ENDPOINT=https://ai-prod.openai.azure.com/\nGPT4_DEPLOYMENT_NAME=gpt-4-deployment\nGPT4_MODEL=gpt-4\nGPT4_VERSION=1106-preview\nGPT4_CAPACITY=50\n...\nFLUX_DEPLOYMENT_STATUS=manual-required\nDEEPSEEK_DEPLOYMENT_STATUS=manual-required"
  },
  "x-validation-rules": {
    "totalCapacity": "gpt4.capacity + gpt4oMini.capacity + gpt4o.capacity should equal 200",
    "endpointConsistency": "All standard model endpoints should match aiServicesEndpoint pattern",
    "serverlessStatus": "fluxDeployment and deepseekDeployment must have deploymentStatus field"
  }
}
