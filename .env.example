# Azure OpenAI Configuration
# Generated by: ./scripts/outputs.sh <resource-group>
# See: infra/README.md for deployment instructions

# Azure OpenAI Service Endpoint
# Example: https://your-account.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/

# Azure OpenAI API Key (Primary Key)
# Obtained from Azure Portal or via scripts/outputs.sh
AZURE_API_KEY=your-32-character-api-key-here

# Model Deployment Names (5 models, total 260 TPM)
# These names are set in infra/main.parameters.json during deployment

# GPT-4.1 (50 TPM) - Primary GPT model for general tasks
GPT41_DEPLOYMENT_NAME=gpt-4.1

# GPT-4.1-Mini (100 TPM) - Cost-effective GPT for high-volume queries
GPT41_MINI_DEPLOYMENT_NAME=gpt-4.1-mini

# GPT-4o (50 TPM) - High-performance multimodal model
GPT4O_DEPLOYMENT_NAME=gpt-4o

# FLUX-1.1-pro (10 TPM) - Image generation model
FLUX_DEPLOYMENT_NAME=FLUX-1.1-pro

# DeepSeek-V3.1 (50 TPM) - Alternative LLM for specialized tasks
DEEPSEEK_DEPLOYMENT_NAME=DeepSeek-V3.1

# Usage Notes:
# 1. Deploy infrastructure: ./scripts/deploy.sh <resource-group> @infra/main.parameters.json
# 2. Extract values: ./scripts/outputs.sh <resource-group>
# 3. This generates .env.azure-openai with actual values
# 4. Copy .env.azure-openai to .env for Docker Compose usage
# 5. Update docker/litellm/config.yaml to reference these environment variables
